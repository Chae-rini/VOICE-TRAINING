{
  "name": "ullim-web",
  "private": true,
  "version": "0.0.0",
  "description": "울림 웹(PWA) 버전. 분석은 iOS 앱과 같은 방법(YIN·LPC)을 브라우저 안에서 한다.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run",
    "apk:debug": "vite build && cap sync android && sh scripts/gradle.sh assembleDebug",
    "apk:release": "vite build && cap sync android && sh scripts/gradle.sh assembleRelease"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.4",
    "@capacitor/share": "8.0.3",
    "fflate": "0.8.3"
  }
}
